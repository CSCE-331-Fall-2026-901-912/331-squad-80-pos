<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cashier POS - <%= vendor %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { margin: 0; font-family: system-ui, sans-serif; background: #f4f6f8; color: #111; display: flex; flex-direction: column; height: 100vh; overflow: hidden; touch-action: manipulation; }
        
        /* Top Navigation Bar */
        .navbar { display: flex; justify-content: space-between; align-items: center; padding: 0 1.5rem; height: 60px; background: #fff; border-bottom: 1px solid #ddd; }
        .logo { font-weight: bold; font-size: 1.1rem; text-decoration: none; color: #111; }
        
        /* Daily Orders Tracker in Navbar */
        .daily-tracker { font-size: 0.95rem; font-weight: 600; color: #444; background: #f1f3f5; padding: 0.4rem 0.8rem; border-radius: 6px; border: 1px solid #dcdfe6; }
        
        /* Cashier Workspace Layout */
        .cashier-workspace { display: flex; flex: 1; height: calc(100vh - 60px); overflow: hidden; }
        .menu-section { flex: 1; display: flex; flex-direction: column; padding: 1.5rem; border-right: 2px solid #ddd; background: #fff; overflow: hidden; }
        
        /* Reduced width Current Order panel */
        .cart-section { width: 360px; display: flex; flex-direction: column; background: #fff; padding: 1.25rem; box-shadow: -4px 0 15px rgba(0,0,0,0.05); }
        
        /* Category Navigation Bar */
        .categories { display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.5rem; margin-bottom: 1rem; }
        .cat-btn { padding: 0.6rem 1rem; font-size: 0.95rem; font-weight: 600; border: 2px solid #ccc; background: #f8f9fa; border-radius: 8px; cursor: pointer; white-space: nowrap; }
        .cat-btn.active { background: #007bff; color: white; border-color: #006fe6; }
        
        /* Text-only Item Grid */
        .item-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 0.75rem; overflow-y: auto; flex: 1; padding-right: 0.25rem; }
        .item-card { background: #fafbfc; border: 2px solid #e1e4e8; border-radius: 8px; padding: 0.85rem; text-align: left; cursor: pointer; display: flex; flex-direction: column; justify-content: space-between; min-height: 85px; transition: transform 0.1s, background 0.1s; }
        .item-card:active { transform: scale(0.97); background: #f0f3f6; }
        .item-name { font-weight: 700; font-size: 0.95rem; margin-bottom: 0.25rem; }
        .item-price { font-weight: 600; color: #28a745; font-size: 0.95rem; }
        .sold-out-label { color: #dc3545; font-size: 0.75rem; font-weight: bold; }

        /* Cart & Checkout Panel */
        .cart-items { flex: 1; overflow-y: auto; border: 1px solid #e1e4e8; border-radius: 8px; margin-bottom: 1rem; padding: 0.75rem; background: #fafbfc; }
        .cart-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 0.6rem 0; border-bottom: 1px solid #eee; font-size: 0.9rem; }
        .cart-row-details { font-size: 0.75rem; color: #666; margin-top: 0.15rem; }
        
        .totals-box { font-size: 1.15rem; font-weight: 700; display: flex; justify-content: space-between; margin-bottom: 0.5rem; padding-top: 0.5rem; border-top: 2px solid #ddd; }
        
        /* Small Status Feedback Message */
        .status-msg { font-size: 0.8rem; color: #28a745; text-align: center; height: 1.2rem; margin-bottom: 0.5rem; font-weight: 600; }

        .submit-btn { background: #28a745; color: white; border: none; padding: 0.9rem; font-size: 1.15rem; font-weight: 700; border-radius: 8px; cursor: pointer; width: 100%; text-align: center; }
        .submit-btn:active { background: #218838; }
        
        .qty-controls { display: flex; align-items: center; gap: 0.4rem; }
        .qty-btn { background: #e2e8f0; border: none; padding: 0.2rem 0.5rem; font-weight: bold; border-radius: 4px; cursor: pointer; font-size: 0.85rem; }

        /* Modal Customization Overlay */
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; z-index: 1000; }
        .modal-content { background: #fff; padding: 1.5rem; border-radius: 10px; width: 400px; max-width: 90%; box-shadow: 0 4px 20px rgba(0,0,0,0.15); }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid #eee; padding-bottom: 0.5rem; }
        .modal-close { background: none; border: none; font-size: 1.25rem; font-weight: bold; cursor: pointer; }
        .option-group { margin-bottom: 1rem; }
        .option-group label { display: block; font-weight: 600; margin-bottom: 0.3rem; font-size: 0.9rem; }
        .option-group select { width: 100%; padding: 0.5rem; border-radius: 6px; border: 1px solid #ccc; }
        .addons-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; max-height: 150px; overflow-y: auto; border: 1px solid #eee; padding: 0.5rem; border-radius: 6px; }
        .addon-option { display: flex; align-items: center; gap: 0.4rem; font-size: 0.85rem; cursor: pointer; }
        .modal-footer { display: flex; gap: 0.75rem; margin-top: 1.5rem; }
        .modal-add-btn { background: #007bff; color: white; border: none; padding: 0.75rem; font-weight: bold; border-radius: 6px; cursor: pointer; flex: 1; }
        .modal-cancel-btn { background: #e2e8f0; border: none; padding: 0.75rem; font-weight: bold; border-radius: 6px; cursor: pointer; }
    </style>
</head>
<body>
    <!-- Top Navigation Bar with Dynamic Database Daily Orders Tracker -->
    <header class="navbar">
        <a class="logo" href="/" aria-label="Return to menu">Menu — <%= vendor %></a>
        <div class="daily-tracker">
            Total Orders Today: <span id="dailyOrderCount"><%= todayCount %></span>
        </div>
    </header>

    <div class="cashier-workspace">
        <div class="menu-section">
            <h2>Behind-the-Counter POS</h2>
            
            <div class="categories">
                <button class="cat-btn active" onclick="filterCategory('all', this)">All Items</button>
                <% categories.forEach(cat => { %>
                    <button class="cat-btn" onclick="filterCategory('<%= cat %>', this)"><%= cat %></button>
                <% }) %>
            </div>

            <div class="item-grid" id="itemGrid">
                <% items.forEach(item => { %>
                    <% 
                        const itemId = item.menu_item_id || item.id;
                        const soldOut = Number(item.is_available) !== 1;
                    %>
                    <div class="item-card <%= soldOut ? 'sold-out' : '' %>" 
                         data-category="<%= item.category || 'Uncategorized' %>" 
                         <% if (!soldOut) { %>
                             onclick="openCustomizeModal(<%= itemId %>, '<%= item.name.replace(/'/g, "\\'") %>', <%= item.current_price %>)"
                         <% } %>
                         style="<%= soldOut ? 'opacity: 0.5; cursor: not-allowed;' : '' %>">
                        <div>
                            <div class="item-name"><%= item.name %></div>
                            <% if (soldOut) { %>
                                <span class="sold-out-label">Sold out</span>
                            <% } %>
                        </div>
                        <div class="item-price">$<%= Number(item.current_price).toFixed(2) %></div>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- Reduced width Current Order panel -->
        <div class="cart-section">
            <h3>Current Order</h3>
            <div class="cart-items" id="cartList">
                <p style="color: #888; text-align: center; margin-top: 3rem;">Tap items on the left to build order</p>
            </div>
            
            <div class="totals-box">
                <span>Total:</span>
                <span id="cartTotal">$0.00</span>
            </div>

            <!-- Small inline status feedback instead of browser alert boxes -->
            <div class="status-msg" id="statusMessage"></div>
            
            <button class="submit-btn" onclick="submitOrder()">Submit Order</button>
        </div>
    </div>

    <!-- Customization Modal Popup -->
    <div class="modal-overlay" id="customizeModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modalItemName" style="margin: 0;">Customize Item</h3>
                <button class="modal-close" onclick="closeCustomizeModal()">×</button>
            </div>
            <div class="option-group">
                <label for="modalSugar">Sugar Level</label>
                <select id="modalSugar">
                    <option value="0%">0%</option>
                    <option value="25%">25%</option>
                    <option value="50%">50%</option>
                    <option value="75%">75%</option>
                    <option value="100%" selected>100%</option>
                </select>
            </div>
            <div class="option-group">
                <label for="modalIce">Ice Level</label>
                <select id="modalIce">
                    <option value="No ice">No ice</option>
                    <option value="Less ice">Less ice</option>
                    <option value="Regular ice" selected>Regular ice</option>
                    <option value="Extra ice">Extra ice</option>
                </select>
            </div>
            <div class="option-group">
                <label>Add-ons</label>
                <div class="addons-grid">
                    <label class="addon-option"><input type="checkbox" name="modalAddon" value="boba" data-price="0.50"> Boba (+$0.50)</label>
                    <label class="addon-option"><input type="checkbox" name="modalAddon" value="grass-jelly" data-price="0.50"> Grass Jelly (+$0.50)</label>
                    <label class="addon-option"><input type="checkbox" name="modalAddon" value="pudding" data-price="0.50"> Pudding (+$0.50)</label>
                    <label class="addon-option"><input type="checkbox" name="modalAddon" value="aloe-vera" data-price="0.50"> Aloe Vera (+$0.50)</label>
                    <label class="addon-option"><input type="checkbox" name="modalAddon" value="lychee-jelly" data-price="0.50"> Lychee Jelly (+$0.50)</label>
                    <label class="addon-option"><input type="checkbox" name="modalAddon" value="coconut-jelly" data-price="0.50"> Coconut Jelly (+$0.50)</label>
                    <label class="addon-option"><input type="checkbox" name="modalAddon" value="crystal-boba" data-price="0.50"> Crystal Boba (+$0.50)</label>
                    <label class="addon-option"><input type="checkbox" name="modalAddon" value="cheese-foam" data-price="1.00"> Cheese Foam (+$1.00)</label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="modal-cancel-btn" onclick="closeCustomizeModal()">Cancel</button>
                <button class="modal-add-btn" id="modalConfirmBtn">Add to Order</button>
            </div>
        </div>
    </div>

    <script>
        let cart = [];
        let activeItemData = null;
        
        // Initialize from server-rendered database value
        let dailyOrderCount = parseInt(document.getElementById('dailyOrderCount').innerText) || 0;

        function filterCategory(category, btn) {
            document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.querySelectorAll('.item-card').forEach(card => {
                if (category === 'all' || card.dataset.category === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function openCustomizeModal(id, name, basePrice) {
            activeItemData = { id, name, basePrice };
            document.getElementById('modalItemName').innerText = `Customize ${name}`;
            document.getElementById('modalSugar').value = '100%';
            document.getElementById('modalIce').value = 'Regular ice';
            document.querySelectorAll('input[name="modalAddon"]').forEach(cb => cb.checked = false);
            
            document.getElementById('customizeModal').style.display = 'flex';
        }

        function closeCustomizeModal() {
            document.getElementById('customizeModal').style.display = 'none';
            activeItemData = null;
        }

        document.getElementById('modalConfirmBtn').onclick = function() {
            if (!activeItemData) return;

            const sugar = document.getElementById('modalSugar').value;
            const ice = document.getElementById('modalIce').value;
            
            const selectedAddons = [];
            let addonTotal = 0;
            document.querySelectorAll('input[name="modalAddon"]:checked').forEach(cb => {
                const price = parseFloat(cb.dataset.price);
                selectedAddons.push({ name: cb.value, price: price });
                addonTotal += price;
            });

            const unitPrice = activeItemData.basePrice + addonTotal;

            const existing = cart.find(i => 
                i.id === activeItemData.id && 
                i.sugar === sugar && 
                i.ice === ice && 
                JSON.stringify(i.addons) === JSON.stringify(selectedAddons.map(a => a.name))
            );

            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({
                    id: activeItemData.id,
                    name: activeItemData.name,
                    price: unitPrice,
                    basePrice: activeItemData.basePrice,
                    quantity: 1,
                    sugar: sugar,
                    ice: ice,
                    addons: selectedAddons.map(a => a.name)
                });
            }

            renderCart();
            closeCustomizeModal();
        };

        function updateQty(index, delta) {
            cart[index].quantity += delta;
            if (cart[index].quantity <= 0) {
                cart.splice(index, 1);
            }
            renderCart();
        }

        function renderCart() {
            const listEl = document.getElementById('cartList');
            const totalEl = document.getElementById('cartTotal');
            if (cart.length === 0) {
                listEl.innerHTML = '<p style="color: #888; text-align: center; margin-top: 3rem;">Tap items on the left to build order</p>';
                totalEl.innerText = '$0.00';
                return;
            }

            let html = '';
            let total = 0;
            cart.forEach((item, index) => {
                const itemTotal = item.price * item.quantity;
                total += itemTotal;
                
                let detailsText = `${item.sugar}, ${item.ice}`;
                if (item.addons && item.addons.length > 0) {
                    detailsText += ` + ${item.addons.join(', ')}`;
                }

                html += `
                    <div class="cart-row">
                        <div>
                            <strong>${item.name}</strong>
                            <div class="cart-row-details">$${Number(item.price).toFixed(2)} each (${detailsText})</div>
                        </div>
                        <div class="qty-controls">
                            <button class="qty-btn" onclick="updateQty(${index}, -1)">-</button>
                            <span>${item.quantity}</span>
                            <button class="qty-btn" onclick="updateQty(${index}, 1)">+</button>
                        </div>
                    </div>
                `;
            });
            listEl.innerHTML = html;
            totalEl.innerText = '$' + total.toFixed(2);
        }

        async function submitOrder() {
            const statusEl = document.getElementById('statusMessage');
            if (cart.length === 0) {
                statusEl.style.color = '#dc3545';
                statusEl.innerText = 'Cart is empty.';
                return;
            }

            try {
                const response = await fetch('/api/orders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ items: cart })
                });

                if (response.ok) {
                    const data = await response.json();
                    
                    // Increment and update UI count after successful DB write
                    dailyOrderCount++;
                    document.getElementById('dailyOrderCount').innerText = dailyOrderCount;
                    
                    statusEl.style.color = '#28a745';
                    statusEl.innerText = `Order #${data.orderId} submitted successfully!`;
                    
                    cart = [];
                    renderCart();

                    setTimeout(() => {
                        statusEl.innerText = '';
                    }, 4000);
                } else {
                    const err = await response.json();
                    statusEl.style.color = '#dc3545';
                    statusEl.innerText = 'Error: ' + (err.error || 'Failed to submit order.');
                }
            } catch (err) {
                console.error(err);
                statusEl.style.color = '#dc3545';
                statusEl.innerText = 'Network error submitting order.';
            }
        }
    </script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu Selection</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <!-- Navigation Bar -->
    <header class="navbar">
        <div class="logo">Menu</div>
        <nav class="nav-links">
            <a href="/checkout" class="checkout-btn">
                🛒 Checkout <span id="cart-count" class="cart-badge">0</span>
            </a>
        </nav>
    </header>

    <main class="main-layout">
        <!-- Main Centered Container Banner -->
        <div class="center-banner">
            
            <!-- Category Filter Buttons -->
            <section id="categories" class="category-section">
                <h2>Categories</h2>
                <div class="category-buttons">
                    <button class="cat-btn active" data-category="all">All Items</button>
                    <% if (categories && categories.length > 0) { %>
                        <% categories.forEach(function(cat) { %>
                            <button class="cat-btn" data-category="<%= cat %>">
                                <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
                            </button>
                        <% }); %>
                    <% } %>
                </div>
            </section>

            <!-- Vertical Menu List -->
            <section class="menu-list-section">
                <h2>Menu Items</h2>
                <div id="item-list" class="item-list">
                    <% if (items && items.length > 0) { %>
                        <% items.forEach(function(item) { %>
                            <div class="item-card" data-category="<%= item.category %>">
                                <div class="item-info">
                                    <h3 class="item-title"><%= item.name %></h3>
                                    <p class="item-desc"><%= item.description %></p>
                                </div>
                                <div class="item-footer">
                                    <span class="item-price">$<%= (Number(item.current_price) || 0).toFixed(2) %></span>
                                    <button class="add-btn" data-id="<%= item.menu_item_id || item.id %>" data-name="<%= item.name %>" data-price="<%= Number(item.current_price) || 0 %>">
                                        Add to Cart
                                    </button>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="no-items">No items found in database.</p>
                    <% } %>
                </div>
            </section>

        </div>
        <!-- Right-Hand Cart Display Box Sidebar -->
        <aside class="cart-sidebar">
            <div class="cart-box">
                <h3>Your Cart</h3>
                <ul id="cart-items-list" class="cart-items-list">
                    <li class="empty-cart-msg">Your cart is empty</li>
                </ul>
                <div class="cart-total-section">
                    <span>Total:</span>
                    <span id="cart-total-price">$0.00</span>
                </div>
                <a href="/checkout" class="proceed-checkout-btn">Proceed to Checkout</a>
            </div>
        </aside>
    </main>

    <!-- Embedded Client-Side Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // 1. Category Filtering Logic
            const categoryButtons = document.querySelectorAll('.cat-btn');
            const itemCards = document.querySelectorAll('.item-card');

            categoryButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const selectedCategory = button.getAttribute('data-category');

                    // Update active state on buttons
                    categoryButtons.forEach(btn => btn.classList.remove('active'));
                    button.classList.add('active');

                    // Filter menu items
                    itemCards.forEach(card => {
                        const cardCategory = card.getAttribute('data-category');
                        
                        if (selectedCategory === 'all' || cardCategory === selectedCategory) {
                            card.style.display = 'flex';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });

            // 2. Interactive Cart Logic
            const cart = [];
            const cartCountEl = document.getElementById('cart-count');
            const cartItemsListEl = document.getElementById('cart-items-list');
            const cartTotalPriceEl = document.getElementById('cart-total-price');
            const addButtons = document.querySelectorAll('.add-btn');

            addButtons.forEach(button => {
                button.addEventListener('click', () => {
                    const id = button.getAttribute('data-id');
                    const name = button.getAttribute('data-name');
                    const price = parseFloat(button.getAttribute('data-price')) || 0;

                    // Check if item already exists in cart
                    const existingItem = cart.find(item => item.id === id);
                    if (existingItem) {
                        existingItem.quantity++;
                    } else {
                        cart.push({ id, name, price, quantity: 1 });
                    }

                    updateCartUI();
                });
            });

            function updateCartUI() {
                // Clear current list view
                cartItemsListEl.innerHTML = '';

                if (cart.length === 0) {
                    cartItemsListEl.innerHTML = '<li class="empty-cart-msg">Your cart is empty</li>';
                    cartCountEl.textContent = '0';
                    cartTotalPriceEl.textContent = '$0.00';
                    return;
                }

                let totalCount = 0;
                let totalPrice = 0;

                cart.forEach(item => {
                    totalCount += item.quantity;
                    totalPrice += item.price * item.quantity;

                    const li = document.createElement('li');
                    li.className = 'cart-item-row';
                    li.innerHTML = `
                        <span>${nameEllipsis(item.name)} (x${item.quantity})</span>
                        <span>$${(item.price * item.quantity).toFixed(2)}</span>
                    `;
                    cartItemsListEl.appendChild(li);
                });

                cartCountEl.textContent = totalCount;
                cartTotalPriceEl.textContent = `$${totalPrice.toFixed(2)}`;
            }

            function nameEllipsis(name) {
                return name.length > 18 ? name.substring(0, 15) + '...' : name;
            }
        });
    </script>
    
</body>
</html>